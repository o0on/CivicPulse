  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Municipal Complaints Ingestion Rate (by Category)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (category) (rate(civicpulse_complaints_total[1m]))",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Triage Processing Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(civicpulse_triage_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(civicpulse_triage_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Complaints by Current Status",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (status) (civicpulse_complaints_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Redis Stats Cache Hit vs Miss Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(civicpulse_cache_hits_total[5m])) / (sum(rate(civicpulse_cache_hits_total[5m])) + sum(rate(civicpulse_cache_misses_total[5m]))) * 100",
          "legendFormat": "Hit Rate %",
          "refId": "A"
        }
      ]
    }
  ],
